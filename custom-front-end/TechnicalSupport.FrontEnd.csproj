<Project Sdk="Transpose.Build.Target/26.10.7421">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- No LangVersion: the Transpose SDK defaults it to `latest`, which is what tps compiles at.
         CS1998 = async method without await, CA2007 = ConfigureAwait: noise in transpiled code. -->
    <NoWarn>CS1998;CA2007</NoWarn>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DefineConstants>Transpose</DefineConstants>
  </PropertyGroup>

  <!-- Keep these on the versions your workspace's own front end uses: a front end on older Transpose or
       Tesserae packages than the server boots to the loading screen. -->
  <ItemGroup>
    <PackageReference Include="Transpose.BCL"             Version="26.11.7972" />
    <PackageReference Include="Transpose.Newtonsoft.Json" Version="26.10.7422" />
    <PackageReference Include="Tesserae"                  Version="2026.11.73650" />
    <PackageReference Include="Curiosity.FrontEnd.API"    Version="26.11.8092" />
    <PackageReference Include="Curiosity.FrontEnd.Core"   Version="26.11.8092" />
    <PackageReference Include="Curiosity.FrontEnd.Admin"  Version="26.11.8092" />
    <PackageReference Include="Curiosity.FrontEnd"        Version="26.11.8092" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- A Release build uploads the compiled site to the workspace with the Curiosity CLI
       (dotnet tool install -g Curiosity.CLI). Set CURIOSITY_URL and CURIOSITY_UPLOAD_TOKEN (an 'Interface Upload'
       token from Manage > Tokens) in your environment; without them the build only compiles.
       To upload by hand instead, zip the tps output folder (zip-output-folder.ps1) and upload it under Manage > Interfaces. -->
  <Target Name="UploadFrontEnd" AfterTargets="Build" Condition="'$(Configuration)'=='Release' And '$(CURIOSITY_URL)'!='' And '$(CURIOSITY_UPLOAD_TOKEN)'!=''">
    <Exec Command="curiosity-cli upload-front-end -s $(CURIOSITY_URL) -t $(CURIOSITY_UPLOAD_TOKEN) -p $(ProjectDir)bin/$(Configuration)/netstandard2.0/tps/" />
  </Target>
</Project>
