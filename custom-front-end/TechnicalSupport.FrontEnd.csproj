<Project Sdk="Transpose.Build.Target/26.8.4125">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>1998</NoWarn>          <!-- Disable warning for async method without any await -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DefineConstants>TRANSPOSE</DefineConstants>
  </PropertyGroup>


  <!-- Don't forget  to perform a NuGet packages update to fetch the latest versions!

       Pinned to the newest set that still produces a runnable site: Tesserae 2026.8.69630 and
       Curiosity.FrontEnd 26.8.4106 switched their published JavaScript to on-demand ES module
       chunks, and the Transpose compiler currently available for Linux/Windows (26.8.4124) emits
       an index.html that never loads those chunks, so every type outside the eager set is still a
       stub when Main runs (`tss.Router.Register is not a function`). Bump these once a Transpose
       compiler that preloads the chunks ships. -->
  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.8.4275" />
    <PackageReference Include="Transpose.Core" Version="26.8.4176" />
    <PackageReference Include="Transpose.Newtonsoft.Json" Version="26.8.4126" />
    <PackageReference Include="Tesserae" Version="2026.8.69806" />
    <PackageReference Include="Curiosity.FrontEnd.API" Version="26.8.4271" />
    <PackageReference Include="Curiosity.FrontEnd.Core" Version="26.8.4271" />
    <PackageReference Include="Curiosity.FrontEnd.Admin" Version="26.8.4271" />
    <PackageReference Include="Curiosity.FrontEnd" Version="26.8.4271" />
    <PackageReference Include="Tesserae.GraphKit" Version="26.8.4159" />
  </ItemGroup>
  <ItemGroup>
    <None Update="tps\assets\css\support-style.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- When building in release mode, zips the output folder so it can be uploaded to the workspace via the UI -->
  <!--Condition="'$(Configuration)'=='Release'"-->
  <Target Name="ZipOutput" AfterTargets="Build">
    <!--<Exec Command="powershell.exe .\zip-output-folder.ps1 $(ProjectDir)bin\$(Configuration)\netstandard2.0\tps\" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />-->
    
    <!--You can alternativelly remove the previous line and upload directly the front-end to your Curiosity workspace using the Curiosity CLI tool. You'll need to install the tool using 'dotnet tool install -g Curiosity.CLI'  and generate a token in the workspace for 'Interface Upload'-->
    <Exec Command="curiosity-cli upload-front-end -s http://localhost:8080/ -t eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJGb3IiOiJGUk9OVF9FTkRfVVBMT0FEIiwiQ3JlYXRlZEJ5IjoiYWRtaW4iLCJQdXJwb3NlIjoiZGV2IiwibmJmIjoxNzg3MjE5NDc2LCJleHAiOjIxMDI1Nzk1MzYsImlzcyI6IkN1cmlvc2l0eS5TZWN1cml0eS5CZWFyZXIiLCJhdWQiOiJDdXJpb3NpdHkifQ.wfSFdpH97ZuiLTlx7MuLWQC1icLq67CeKzro-l7wpN0 -p $(ProjectDir)bin/$(Configuration)/netstandard2.0/tps/" ContinueOnError="true" />
  </Target>
</Project>
